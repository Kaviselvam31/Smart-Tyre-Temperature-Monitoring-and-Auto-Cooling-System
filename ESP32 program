Create src/smart_tyre_monitor.ino and add this beginner-friendly program. It reads the LM35, displays the temperature in Serial Monitor, activates the relay above 80°C, and turns it off once the temperature falls below 75°C.
This uses Arduino C++ for ESP32, which is commonly used for embedded projects. If your assessment requires pure Embedded C, you can later port the logic to ESP-IDF.

#include <Arduino.h>

const int TEMP_SENSOR_PIN = 34;
const int RELAY_PIN = 26;

const float HIGH_TEMP = 80.0;
const float LOW_TEMP = 75.0;

// Change these if your relay module is active LOW.
const int RELAY_ON = HIGH;
const int RELAY_OFF = LOW;

bool coolingOn = false;

float readTemperature() {
    int adcValue = analogRead(TEMP_SENSOR_PIN);

    // Approximate ADC conversion for a 3.3V ESP32 ADC.
    float voltage = adcValue * (3.3 / 4095.0);

    // LM35 output: approximately 10 mV per degree Celsius.
    return voltage * 100.0;
}

void setup() {
    Serial.begin(115200);

    pinMode(RELAY_PIN, OUTPUT);
    digitalWrite(RELAY_PIN, RELAY_OFF);

    analogReadResolution(12);
    analogSetPinAttenuation(
        TEMP_SENSOR_PIN, ADC_11db
    );

    Serial.println("Smart Tyre Temperature Monitor");
}

void loop() {
    float temperature = readTemperature();

    Serial.print("Temperature: ");
    Serial.print(temperature, 1);
    Serial.println(" C");

    if (temperature >= HIGH_TEMP && !coolingOn) {
        coolingOn = true;
        digitalWrite(RELAY_PIN, RELAY_ON);
        Serial.println("WARNING: High temperature!");
        Serial.println("Cooling activated.");
    }
    else if (temperature <= LOW_TEMP && coolingOn) {
        coolingOn = false;
        digitalWrite(RELAY_PIN, RELAY_OFF);
        Serial.println("Temperature reduced.");
        Serial.println("Cooling deactivated.");
    }

    delay(1000);
}


